<% layout("/layouts/boilerplate") %>

<style>
    /* ================= FILTERS ================= */

    #filters {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 2rem;
        padding: 1rem 0;
    }

    .filters {
        min-width: 60px;
        text-align: center;
        opacity: 0.7;
        cursor: pointer;
    }

    .filters:hover {
        opacity: 1;
    }

    .filters i {
        font-size: 1.2rem;
    }

    .filters p {
        margin-top: 0.5rem;
        margin-bottom: 0;
        font-size: 0.75rem;
    }


    /* ================= TAX TOGGLE ================= */

    .tax-toggle {
        margin-left: auto;
        margin-right: 1rem;
        white-space: nowrap;
    }

    .tax-toggle .form-check {
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .tax-toggle .form-check-label {
        margin: 0;
        font-size: 0.85rem;
    }

    .tax-toggle .form-check-input {
        margin: 0;
    }


    /* ================= TAX INFO ================= */

    .taxInfo {
        display: none;
        font-size: 0.9rem;
    }
</style>


<!-- ================= FILTER CATEGORIES ================= -->

<div id="filters">

    <div class="filters">
        <div>
            <i class="fa-solid fa-fire"></i>
        </div>
        <p>Trending</p>
    </div>

    <div class="filters">
        <div>
            <i class="fa-solid fa-bed"></i>
        </div>
        <p>Rooms</p>
    </div>

    <div class="filters">
        <div>
            <i class="fa-solid fa-mountain-sun"></i>
        </div>
        <p>Iconic Cities</p>
    </div>

    <div class="filters">
        <div>
            <i class="fa-solid fa-mountain"></i>
        </div>
        <p>Mountains</p>
    </div>

    <div class="filters">
        <div>
            <i class="fa-solid fa-chess-rook"></i>
        </div>
        <p>Castles</p>
    </div>

    <div class="filters">
        <div>
            <i class="fa-solid fa-person-swimming"></i>
        </div>
        <p>Amazing Pools</p>
    </div>

    <div class="filters">
        <div>
            <i class="fa-solid fa-campground"></i>
        </div>
        <p>Camping</p>
    </div>

    <div class="filters">
        <div>
            <i class="fa-solid fa-tractor"></i>
        </div>
        <p>Farms</p>
    </div>

    <div class="filters">
        <div>
            <i class="fa-solid fa-snowflake"></i>
        </div>
        <p>Arctic</p>
    </div>


    <!-- ================= TAX SWITCH ================= -->

  <div class="tax-toggle">

    <span>Display total after taxes</span>

    <label class="switch">
        <input type="checkbox" id="switchCheckDefault">
        <span class="slider"></span>
    </label>

   </div>

</div>


<!-- ================= LISTINGS ================= -->

<div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-3">

    <% for (let listing of allListings) { %>

        <a
            href="/listings/<%= listing._id %>"
            class="listing-link"
        >

            <div class="col mb-4">

                <div class="card listing-card">

                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top"
                        alt="listing_image"
                        style="height: 20rem;"
                    >

                    <div class="card-img-overlay"></div>

                    <div class="card-body">

                        <p class="card-text">

                            <b>
                                <%= listing.title %>
                            </b>

                            <br>

                            &#8377;
                            <%= listing.price.toLocaleString("en-IN") %>
                            /night

                            <i class="taxInfo">
                                &nbsp;&nbsp;+18% GST
                            </i>

                        </p>

                    </div>

                </div>

            </div>

        </a>

    <% } %>

</div>


<!-- ================= JAVASCRIPT ================= -->

<script>

    let taxSwitch = document.getElementById("switchCheckDefault");

    taxSwitch.addEventListener("click", () => {

        let taxInfo = document.getElementsByClassName("taxInfo");

        for (let info of taxInfo) {

            if (taxSwitch.checked) {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }

        }

    });

</script>